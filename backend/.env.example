PORT=8001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Chatbot (opsional). Kosong = chatbot memakai mode cadangan kata kunci.
# Ambil key di https://aistudio.google.com/apikey — JANGAN beri awalan NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Midtrans Snap sandbox (opsional). Isi keduanya untuk mengganti top up simulasi dengan Midtrans.
# Ambil di https://dashboard.sandbox.midtrans.com > Settings > Access Keys.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
